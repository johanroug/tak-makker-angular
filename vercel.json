{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/tak-makker-angular/browser",
  "rewrites": [
    {
      "source": "/:page(tilbudsprogram-til-toemrer|tilbudsprogram-til-murer|tilbudsprogram-til-maler)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/:page(login|register|forgot-password|reset-password|projects|offers|activity|users|company-profile)/:path*",
      "destination": "/index.csr.html"
    }
  ],
  "headers": [
    {
      "source": "/:page(login|register|forgot-password|reset-password|projects|offers|activity|users|company-profile)/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/index.csr.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
